{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "eudeka/laravel-mailer",
  "description": "Resilient multi-vendor email transport with failover and circuit breaker for Laravel",
  "version": "1.0.0",
  "keywords": [
    "laravel",
    "eudeka",
    "mailer",
    "email",
    "failover"
  ],
  "homepage": "https://github.com/eudeka/laravel-mailer",
  "license": "MIT",
  "authors": [
    {
      "name": "Eudeka",
      "email": "connect@eudeka.id",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/support": "^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.11",
    "laravel/pint": "^1.30.5",
    "laravel/pao": "^1.1.4",
    "orchestra/testbench": "^11.2",
    "pestphp/pest": "^4.6||^5.1.3",
    "pestphp/pest-plugin-laravel": "^4.1||^5.0.1",
    "pestphp/pest-plugin-type-coverage": "^4.0||^5.0.2",
    "phpstan/extension-installer": "^1.4.3"
  },
  "autoload": {
    "psr-4": {
      "Eudeka\\LaravelMailer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Eudeka\\LaravelMailer\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/",
      "Workbench\\Database\\Factories\\": "workbench/database/factories/",
      "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "prepare": [
      "@php vendor/bin/testbench package:discover --ansi"
    ],
    "build": [
      "@php vendor/bin/testbench workbench:build --ansi"
    ],
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@build",
      "@php vendor/bin/testbench serve --ansi"
    ],
    "lint": [
      "vendor/bin/pint --parallel"
    ],
    "lint:check": [
      "vendor/bin/pint --parallel --test"
    ],
    "analyse": [
      "vendor/bin/phpstan analyse --memory-limit=1G"
    ],
    "test:types": [
      "php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100"
    ],
    "test:unit": [
      "vendor/bin/pest --parallel"
    ],
    "test": [
      "@analyse",
      "@lint:check",
      "@test:types",
      "@test:unit"
    ],
    "clear": [
      "@php vendor/bin/testbench package:purge-skeleton --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Eudeka\\LaravelMailer\\LaravelMailerServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
